# OpenAI-compatible endpoint. Default is the local llama-server started by scripts/llama_server.py.
TABLETALK_BASE_URL=http://127.0.0.1:8080/v1
TABLETALK_MODEL=local
TABLETALK_API_KEY=sk-local

# GGUF used by scripts/llama_server.py (path) and by docker-compose (file name under ./models)
LLM_MODEL_PATH=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
LLM_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf

# Limits per question
TABLETALK_MAX_ROWS=200
TABLETALK_SQL_TIMEOUT=10
TABLETALK_MAX_REPAIRS=3
TABLETALK_MAX_TOOL_CALLS=8
TABLETALK_SCHEMA_BUDGET=2000
TABLETALK_SANDBOX_TIMEOUT=20

# Output locations
TABLETALK_TRACE_DIR=traces
TABLETALK_CHART_DIR=charts
TABLETALK_CHECKPOINTS=checkpoints/threads.sqlite
# Open charts with the default viewer after a chart request (Windows only)
TABLETALK_OPEN_CHARTS=1
