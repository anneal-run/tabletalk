# OpenAI-compatible endpoint. Default is a local llama-server started by scripts/llama_server.py.
TABLETALK_BASE_URL=http://127.0.0.1:8080/v1
TABLETALK_MODEL=local
TABLETALK_API_KEY=sk-local

# GGUF used by scripts/llama_server.py
LLM_MODEL_PATH=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf

# Limits
TABLETALK_MAX_ROWS=200
TABLETALK_SQL_TIMEOUT=10
TABLETALK_MAX_REPAIRS=3
TABLETALK_SCHEMA_BUDGET=2000
TABLETALK_SANDBOX_TIMEOUT=20

# Optional tracing to Langfuse (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
